{
  "mcpServers": {
    "XcodeBuildMCP": {
      "command": "sh",
      "args": ["-c", "mkdir -p \"$TMPDIR\" && exec npx -y xcodebuildmcp@2.7.0 mcp"],
      "env": { "TMPDIR": "${HOME}/Library/Caches/workout-app-xcodebuildmcp" }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}" }
    }
  }
}
