{
  "permissions": {
    "allow": [
      "Bash(scripts/lint.sh)",
      "Bash(scripts/ci-wait.sh *)",
      "Bash(scripts/swift-format-changed.sh)",
      "Bash(scripts/swift-format-changed.sh origin/main)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "AskUserQuestion",
      "mcp__XcodeBuildMCP__boot_sim",
      "mcp__XcodeBuildMCP__open_sim",
      "mcp__XcodeBuildMCP__build_sim",
      "mcp__XcodeBuildMCP__build_run_sim",
      "mcp__XcodeBuildMCP__test_sim",
      "mcp__XcodeBuildMCP__install_app_sim",
      "mcp__XcodeBuildMCP__launch_app_sim",
      "mcp__XcodeBuildMCP__erase_sims",
      "mcp__XcodeBuildMCP__clean",
      "mcp__XcodeBuildMCP__build_device",
      "mcp__XcodeBuildMCP__build_run_device",
      "mcp__XcodeBuildMCP__test_device",
      "mcp__XcodeBuildMCP__build_macos",
      "mcp__XcodeBuildMCP__build_run_macos",
      "mcp__XcodeBuildMCP__test_macos",
      "mcp__XcodeBuildMCP__swift_package_build",
      "mcp__XcodeBuildMCP__swift_package_run",
      "mcp__XcodeBuildMCP__swift_package_test",
      "mcp__XcodeBuildMCP__xcode_ide_call_tool"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-.}/scripts/warn-stale-checkout.sh\"; [ -x \"$p\" ] && exec \"$p\"; exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-.}/scripts/python-env.sh\"; [ -x \"$p\" ] && exec \"$p\"; exit 0",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true
}
