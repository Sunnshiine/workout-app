{
  "permissions": {
    "allow": [
      "Bash(scripts/lint.sh)",
      "Bash(scripts/ci-wait.sh *)",
      "Bash(scripts/swift-format-changed.sh)",
      "Bash(scripts/swift-format-changed.sh origin/main)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "AskUserQuestion"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-.}/scripts/warn-stale-checkout.sh\"; [ -x \"$p\" ] && exec \"$p\"; exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-.}/scripts/python-env.sh\"; [ -x \"$p\" ] && exec \"$p\"; exit 0",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true
}
