{
  "name": "workout-app-agent-tooling",
  "private": true,
  "type": "module",
  "description": "Node tooling for the scheduled architecture review (tools/architecture-review/) and the prototype capture (scripts/prototype-capture/). The app itself is Swift — see Package.swift.",
  "scripts": {
    "test:architecture-review": "vitest run tools/architecture-review",
    "test:prototype": "vitest run scripts/prototype-capture",
    "typecheck": "tsc --noEmit",
    "prototype:capture": "tsx ./scripts/prototype-capture/capture.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@types/node": "^22.15.0",
    "playwright": "~1.56.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zod": "^4.3.5"
  }
}
