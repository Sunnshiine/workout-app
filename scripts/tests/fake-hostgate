#!/bin/sh
# A stand-in for hostgate, for the tests of scripts that run heavy builds through scripts/build-slot.sh.
# Copy it to <dir>/hostgate and put <dir> first on PATH, so no test takes a real host slot.
# --version prints FAKE_HOSTGATE_VERSION (default 1.0.0). `run [--label L] [--wait S] -- CMD...` appends
# "label=L wait=S nested=yes|no CMD..." to FAKE_HOSTGATE_LOG (wait - when not given), then runs CMD
# with HOSTGATE_SLOT set, as the real one does. FAKE_HOSTGATE_GIVE_UP=1 makes a run that is not nested
# print a give-up line and exit 75 without running CMD. FAKE_HOSTGATE_SAY=<line> prints that line on
# stderr before CMD runs, as the real one prints its wait lines.
case ${1:-} in
  --version) echo "${FAKE_HOSTGATE_VERSION:-1.0.0}"; exit 0 ;;
  run) shift ;;
  *) echo "fake hostgate: unsupported: $*" >&2; exit 64 ;;
esac
label= wait=-
while [ $# -gt 0 ] && [ "$1" != -- ]; do
  case $1 in
    --label) label=$2; shift 2 ;;
    --wait) wait=$2; shift 2 ;;
    *) echo "fake hostgate: unsupported run option: $1" >&2; exit 64 ;;
  esac
done
[ "${1:-}" = -- ] || { echo "fake hostgate: run needs -- and a command" >&2; exit 64; }
shift
nested=no
[ -z "${HOSTGATE_SLOT:-}" ] || nested=yes
echo "label=$label wait=$wait nested=$nested $*" >> "${FAKE_HOSTGATE_LOG:-/dev/null}"
if [ $nested = no ] && [ -n "${FAKE_HOSTGATE_GIVE_UP:-}" ]; then
  echo "hostgate: gave up waiting for a slot held by workout-app:neighbour" >&2
  exit 75
fi
[ -z "${FAKE_HOSTGATE_SAY:-}" ] || echo "$FAKE_HOSTGATE_SAY" >&2
HOSTGATE_SLOT=${HOSTGATE_SLOT:-1} exec "$@"
