#!/bin/sh
# A stand-in for hostgate, for the tests of scripts that run heavy builds through scripts/build-slot.sh.
# Copy it to <dir>/hostgate and put <dir> first on PATH, so no test takes a real host slot.
# --version prints FAKE_HOSTGATE_VERSION (default 1.0.0). `run [--label L] [--wait S] -- CMD...` appends
# "label=L wait=S nested=yes|no CMD..." to FAKE_HOSTGATE_LOG (wait - when not given), then runs CMD
# with HOSTGATE_SLOT set, as the real one does. FAKE_HOSTGATE_GIVE_UP=1 makes a run that is not nested
# print a give-up line and exit 75 without running CMD. FAKE_HOSTGATE_SAY=<line> prints that line on
# stderr before CMD runs, as the real one prints its wait lines. FAKE_HOSTGATE_BROKEN=<status> makes run
# fail with that status before it starts CMD, as an install that cannot import its own code does, and
# fails check the same way. FAKE_HOSTGATE_DIE=<signal> makes run die of that signal before it starts CMD,
# and FAKE_HOSTGATE_NOOP=1 makes it exit 0 without starting CMD. FAKE_HOSTGATE_PIN_LOG=<file> gets
# HOSTGATE_PIN_FILE, or -, appended per run. `check ARGS` appends "check ARGS" to FAKE_HOSTGATE_CHECK_LOG, sleeps
# FAKE_HOSTGATE_CHECK_SLEEP seconds, prints FAKE_HOSTGATE_CHECK_OUT, and exits FAKE_HOSTGATE_CHECK_RC (0).
broken() {
  echo "Traceback (most recent call last): ImportError: hostgate is broken" >&2
  exit "$FAKE_HOSTGATE_BROKEN"
}
case ${1:-} in
  --version) echo "${FAKE_HOSTGATE_VERSION:-1.0.0}"; exit 0 ;;
  run) shift ;;
  check)
    echo "$*" >> "${FAKE_HOSTGATE_CHECK_LOG:-/dev/null}"
    [ -z "${FAKE_HOSTGATE_BROKEN:-}" ] || broken
    [ -z "${FAKE_HOSTGATE_CHECK_SLEEP:-}" ] || sleep "$FAKE_HOSTGATE_CHECK_SLEEP"
    [ -z "${FAKE_HOSTGATE_CHECK_OUT:-}" ] || printf '%s\n' "$FAKE_HOSTGATE_CHECK_OUT"
    exit "${FAKE_HOSTGATE_CHECK_RC:-0}" ;;
  *) echo "fake hostgate: unsupported: $*" >&2; exit 64 ;;
esac
label= wait=-
while [ $# -gt 0 ] && [ "$1" != -- ]; do
  case $1 in
    --label) label=$2; shift 2 ;;
    --wait) wait=$2; shift 2 ;;
    *) echo "fake hostgate: unsupported run option: $1" >&2; exit 64 ;;
  esac
done
[ "${1:-}" = -- ] || { echo "fake hostgate: run needs -- and a command" >&2; exit 64; }
shift
[ -z "${FAKE_HOSTGATE_BROKEN:-}" ] || broken
nested=no
[ -z "${HOSTGATE_SLOT:-}" ] || nested=yes
echo "label=$label wait=$wait nested=$nested $*" >> "${FAKE_HOSTGATE_LOG:-/dev/null}"
echo "${HOSTGATE_PIN_FILE:--}" >> "${FAKE_HOSTGATE_PIN_LOG:-/dev/null}"
[ -z "${FAKE_HOSTGATE_DIE:-}" ] || kill -s "$FAKE_HOSTGATE_DIE" $$
[ -z "${FAKE_HOSTGATE_NOOP:-}" ] || exit 0
if [ $nested = no ] && [ -n "${FAKE_HOSTGATE_GIVE_UP:-}" ]; then
  echo "hostgate: gave up waiting for a slot held by workout-app:neighbour" >&2
  exit 75
fi
[ -z "${FAKE_HOSTGATE_SAY:-}" ] || echo "$FAKE_HOSTGATE_SAY" >&2
HOSTGATE_SLOT=${HOSTGATE_SLOT:-1} exec "$@"
